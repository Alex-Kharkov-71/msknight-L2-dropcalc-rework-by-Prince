# Copy to /etc/dropcalc-sync.conf (chmod 600). Never commit the real file.
LOCAL_CNF=/root/.my-local.cnf       # [client] user=... password=...  (read access to all home databases)
REMOTE_CNF=/root/.my-public.cnf     # [client] user=sync password=...  (on the public MariaDB)
REMOTE_HOST=10.8.0.2                # tunnel address of the public server
REMOTE_PORT=3306
PEPPER=CHANGE_ME_openssl_rand_hex_32   # same value as $password_pepper in the public config.php
LOGIN_PAIR="l2login:pub_login"          # home db : public db
GAME_PAIRS=("l2temp:pub_l2temp" "l2s1:pub_l2s1" "l2pvp:pub_l2pvp")
# Tables you do not want on the public side (db.table), e.g. the biggest one: "l2s1.items" (player inventories, ~190k rows)
EXCLUDE=()
